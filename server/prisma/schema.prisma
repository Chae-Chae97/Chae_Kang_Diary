// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 사용자 정보
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  profile   Profile?
  diaries   Diary[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 사용자 상세 프로필
model Profile {
  id       Int     @id @default(autoincrement())
  nickname String?
  bio      String?
  avatar   String?
  userId   Int     @unique
  user     User    @relation(fields: [userId], references: [id])
}

// 일기장 데이터
model Diary {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  mood      String   // 😊, 😎, 😭 등 이모지 저장
  isSpecial Boolean  @default(false) // 🌟 소중한 기록(북마크) 여부
  date      DateTime // 🚀 실제 일기 기록 날짜 (이제 필수 필드입니다!)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}
